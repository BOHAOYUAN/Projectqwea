# App URL used for Supabase magic-link redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings. The public/publishable key is safe for browser use;
# never expose SUPABASE_SERVICE_ROLE_KEY in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# For older Supabase projects, use this alias instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# PostgreSQL URLs from Supabase. Use the pooler URL at runtime and the direct
# URL for Prisma migrations. Keep both values out of version control.
DATABASE_URL=postgresql://postgres:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Optional: the first approved MS BEAUTY operator. On sign-in, this matching
# email receives the seeded MS BEAUTY OWNER membership; every other account
# still needs an explicit Membership row or can create its own workspace.
INITIAL_OWNER_EMAIL=owner@example.com

# Optional AI integrations. Keys are read on the server only and must never be
# committed, added to a NEXT_PUBLIC_ variable, or entered into a browser form.
# DeepSeek takes priority when configured; this project defaults to V4 Flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional Groq compatibility mode. It is used when DeepSeek is not configured;
# if neither provider is configured, the server safely uses local templates.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback model name for the server-side generator.
DEFAULT_MODEL=openai/gpt-oss-120b
